SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ainative?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=ainative
SPRING_DATASOURCE_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
AINATIVE_SECRET_MASTER_KEY=
AINATIVE_JWT_SECRET=
AINATIVE_PUBLIC_BASE_URL=http://localhost:7001
AINATIVE_VERSION=x.x.x
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-ainative-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
AINATIVE_SLS_ENABLED=false
SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com
SLS_PROJECT=your-sls-project
SLS_SYS_LOGSTORE=ainative-system
SLS_BIZ_LOGSTORE=ainative-business
SLS_METRIC_LOGSTORE=ainative-metrics
SLS_ACCESS_KEY_ID=
SLS_ACCESS_KEY_SECRET=
SLS_TOPIC=
SLS_SOURCE=
AINATIVE_SIGAR_ENABLED=true
AINATIVE_COMMUNITY_EDITION=true
# 7x24 scheduled digital-worker tasks, enabled by default. A fresh install
# imports the complete schema, so the module is ready immediately. When
# upgrading an existing multi-node deployment, set all three to false until
# every node runs the V041 schema; see docs/scheduled-task-operations.md.
AINATIVE_SCHEDULED_TASK_ENABLED=true
AINATIVE_SCHEDULED_TASK_SCANNER_ENABLED=true
AINATIVE_SCHEDULED_TASK_CLUSTER_READY=true
AINATIVE_SCHEDULED_TASK_SCAN_FIXED_DELAY_MS=10000
AINATIVE_SCHEDULED_TASK_SCAN_BATCH_SIZE=100
AINATIVE_SCHEDULED_TASK_LOCK_TTL_SECONDS=30
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
